# No Composio API key is needed: every visitor signs in with their own Composio account.

# Required in production: encrypts visitors' sign-in cookies. At least 32 characters.
# Generate one with: openssl rand -base64 48
# In development a random one is created in .data/session-secret if this is unset.
SESSION_SECRET=

# Optional. Ceiling on Composio Instant spend per visitor, in USD. Default 1.
# INSTANT_BUDGET_USD=1

# Optional. Seconds a streamer feed is reused before Instant is called again. Default 120, minimum 20.
# STREAMS_TTL_SECONDS=120

# Optional. Seconds a social or reaction feed is reused. Default 300, minimum 60.
# SOCIAL_TTL_SECONDS=300

# Optional. Social posts and reactions older than this many hours are dropped. Default 24, minimum 1.
# POST_MAX_AGE_HOURS=24
